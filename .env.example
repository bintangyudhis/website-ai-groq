# Salin berkas ini menjadi .env lalu isi nilainya.
# Kunci API Groq. Dapatkan gratis di https://console.groq.com/keys
GROQ_API_KEY=

# Model Groq yang dipakai (opsional, bawaan llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Port tempat aplikasi berjalan (opsional, bawaan 5000)
PORT=5000
